# Hiindsight 2.0 environment configuration
# Copy to .env.local and fill in your own values. Never commit real keys.

# Site
NEXT_PUBLIC_SITE_URL=https://www.hiindsight.com

# Headless CMS (optional — local content fallback used when absent)
# SANITY_PROJECT_ID=
# SANITY_DATASET=
# SANITY_API_TOKEN=
# CMS_ENABLED=false

# Contact form notification (choose one provider)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=

# Analytics (GA4)
NEXT_PUBLIC_GA4_ID=

# Spam protection (optional)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
